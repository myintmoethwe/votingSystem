<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voter Registration</title>

    <!-- Google Font -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    />

    <link rel="stylesheet" href="style.css" />
  </head>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #1b1b3a, #4b2e83, #00b4d8);
      overflow: hidden;
    }

    /* Background circles */

    body::before {
      content: "";
      position: absolute;
      width: 300px;
      height: 300px;
      background: #00e5ff55;
      border-radius: 50%;
      top: -80px;
      left: -80px;
      filter: blur(40px);
    }

    body::after {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      background: #c77dff55;
      border-radius: 50%;
      bottom: -70px;
      right: -70px;
      filter: blur(40px);
    }

    .container {
      width: 400px;
      text-align: center;
      z-index: 1;
    }

    .logo {
      width: 120px;
      margin-bottom: 15px;
    }

    h2 {
      color: white;
      font-size: 20px;
      font-weight: 500;
    }

    h1 {
      margin: 15px 0 30px;
      font-size: 40px;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
    }

    .card {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 35px;
      border-radius: 25px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .card h3 {
      color: white;
      margin-bottom: 25px;
      font-size: 26px;
    }

    .input-box {
      display: flex;
      align-items: center;
      background: white;
      border-radius: 14px;
      margin: 18px 0;
      padding: 15px;
    }

    .input-box i {
      font-size: 22px;
      color: #89cce0;
      margin-right: 15px;
    }

    .input-box input {
      width: 100%;
      border: none;
      outline: none;
      font-size: 16px;
      background: transparent;
    }

    button {
      width: 100%;
      margin-top: 20px;
      padding: 16px;
      border: none;
      border-radius: 15px;
      background: linear-gradient(90deg, #8e2de2, #00c9ff);
      color: white;
      font-size: 20px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    }

    button i {
      margin-left: 10px;
    }

    .card p {
      margin-top: 25px;
      color: white;
      font-size: 14px;
      line-height: 22px;
    }

    .card p i {
      color: #00ffbf;
      margin-right: 6px;
    }

    @media (max-width: 450px) {
      .container {
        width: 92%;
      }

      .card {
        padding: 25px;
      }

      h1 {
        font-size: 32px;
      }
    }
  </style>
  <body>
    <div class="container">
      <div class="card">
        <img src="./img/mtulogo.png" class="logo" />

        <h2>Mandalay Technological University</h2>

        <h1>Freshers' Welcome</h1>
        <form action="/admin-login" method="POST">
          <div class="input-box">
            <i class="fa-regular fa-user"></i>
            <input type="text" placeholder="Enter your name" name="username" />
          </div>

          <div class="input-box">
            <i class="fa-solid fa-key"></i>
            <input type="password" placeholder="Password" name="password" />
          </div>

          <button>
            Submit
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
