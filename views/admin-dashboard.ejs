<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard - King & Queen</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="../style/admin_dashboard.css">
    <style>
        /* Hide all page sections by default, show active */
        .page-section { display: none; }
        .page-section.active { display: block; }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <span>👑</span>
            <h2>King & Queen</h2>
        </div>

        <nav>

            <a href="#dashboard-page" class="active" onclick="showPage('dashboard', this)">
                <span>📊</span>
                Dashboard
            </a>

            <a href="#candidates-page" onclick="showPage('candidates', this)">
                <span>👥</span>
                Candidates
            </a>

            <a href="#vote-page" onclick="showPage('vote', this)">
                <span>🗳️</span>
                Votes
            </a>

            <a href="#result-page" onclick="showPage('result', this)">
                <span>🏆</span>
                Results
            </a>
            
            <a href="#setting-page" onclick="showPage('setting', this)">
                <span>⚙️</span>
                Settings
            </a>

        </nav>

        <a href="#" class="logout">
            <span>🚪</span>
            Logout
        </a>

    </aside>


    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- Dashboard -->

        <section id="dashboard-page" class="page-section">
            <!-- TOP BAR -->
        <header class="topbar">

            <div>
                <h1>Dashboard</h1>
                <p>Welcome back, Admin!</p>
            </div>

            <div class="admin-profile">

                <div class="admin-avatar">
                    A
                </div>

                <div>
                    <strong>Administrator</strong>
                    <small>Admin</small>
                </div>

            </div>

        </header>


        <!-- STATISTICS -->
        <section class="statistics">

            <div class="stat-card">

                <div class="stat-icon">
                    👥
                </div>

                <div>
                    <p>Total Voters</p>
                    <h2><%= stats ? stats.total_voters : 0 %></h2>            
                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">
                    🗳️
                </div>

                <div>
                    <p>Total Votes</p>
                    <h2><%= stats ? stats.total_votes : 0 %></h2>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    👑
                </div>

                <div>
                    <p>King Votes</p>
                    <h2><%= stats ? stats.total_king_votes : 0 %></h2>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    👸
                </div>

                <div>
                    <p>Queen Votes</p>
                   <h2><%= stats ? stats.total_queen_votes : 0 %></h2>
                </div>

            </div>

            <div class="stat-card">
                    <div class="stat-icon">👸</div>
                    <div>
                        <p>Smart Votes</p>
                        <h2><%= stats ? stats.total_smart_votes : 0 %></h2>

                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">👸</div>
                    <div>
                        <p>Style Votes</p>
                        <h2><%= stats ? stats.total_style_votes : 0 %></h2>

                    </div>
                </div>
                <div class="stat-card">
                <div class="stat-icon">👑</div>
                    <div>
                        <p>Boy Popular Votes</p>
                        <h2><%= stats ? stats.total_boy_popular_votes : 0 %></h2>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">👑</div>
                    <div>
                        <p>Girl Popular Votes</p>
                        <h2><%= stats ? stats.total_girl_popular_votes : 0 %></h2>
                    </div>
                </div>
        </section>


        <!-- VOTING STATUS -->
        <section class="status-card">

            <div>

                <h2>Voting Status</h2>

                <p>
                    King & Queen Selection is currently
                    <strong>OPEN</strong>.
                </p>

            </div>

            <span class="status open">
                ● LIVE
            </span>

        </section>


        <!-- CONTENT GRID -->
        <section class="content-grid">

            <!-- KING RESULTS -->
            <div class="result-card">
                <div class="card-header"> 
                    <h2>👑 King Results</h2>
                    <a href="#" onclick="showPage(event, 'result')">View All</a>
                </div>

                <% if (locals.kings && kings.length > 0) { %>
                    <% kings.forEach((king, index) => { %>
                        <div class="candidate-row">
                            <div class="candidate-info">
                                <div class="rank"><%= index + 1 %></div>
                                <img src="<%= king.photo %>" alt="<%= king.name %>">
                                <div>
                                    <strong><%= king.name %></strong>
                                    <small>K-0<%= king.id %></small>
                                </div>
                            </div>
                            <div class="vote-count">
                                <strong><%= king.kingVotes %></strong>
                                <small>votes</small>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="candidate-row">
                        <div class="candidate-info">
                            <div>
                                <strong>No King Candidates Found</strong>
                                <small>-</small>
                            </div>
                        </div>
                        <div class="vote-count">
                            <strong>0</strong>
                            <small>votes</small>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- QUEEN RESULTS -->
            <div class="result-card">
                <div class="card-header">
                    <h2>👸 Queen Results</h2>
                    <a href="#" onclick="showPage(event, 'result')">View All</a>
                </div>

                <% if (locals.queens && queens.length > 0) { %>
                    <% queens.forEach((queen, index) => { %>
                        <div class="candidate-row">
                            <div class="candidate-info">
                                <div class="rank"><%= index + 1 %></div>
                                <img src="<%= queen.photo %>" alt="<%= queen.name %>">
                                <div>
                                    <strong><%= queen.name %></strong>
                                    <small>Q-0<%= queen.id %></small>
                                </div>
                            </div>
                            <div class="vote-count">
                                <strong><%= queen.queenVotes %></strong>
                                <small>votes</small>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="candidate-row">
                        <div class="candidate-info">
                            <div>
                                <strong>No Queen Candidates Found</strong>
                                <small>-</small>
                            </div>
                        </div>
                        <div class="vote-count">
                            <strong>0</strong>
                            <small>votes</small>
                        </div>
                    </div>
                <% } %>
            </div>

        </section>


        <!-- QUICK ACTIONS -->
        <section class="quick-actions">

            <h2>Quick Actions</h2>

            <div class="action-container">

            <a href="javascript:void(0)" class="action-card" onclick="openAddCandidateModal()">
                <span>➕</span>
                <div>
                    <strong>Add Candidate</strong>
                    <small>Add a new King or Queen</small>
                </div>
            </a>

            <a href="#result-page" class="action-card" onclick="showPage('result', this)">
                <span>📊</span>
                <div>
                    <strong>View Results</strong>
                    <small>Check complete voting results</small>
                </div>
            </a>

            <a href="#setting-page" class="action-card" onclick="showPage('setting', this)">
                <span>⚙️</span>
                <div>
                    <strong>Voting Settings</strong>
                    <small>Manage voting period</small>
                </div>
            </a>

        </div>

        </section>
        </section>


       <!-- CANDIDATES PAGE -->
        <section id="candidates-page" class="page-section">
            <div class="page-header">
                <div>
                    <h1>Candidates</h1>
                    <p>Manage King and Queen candidates</p>
                </div>
                <!-- Trigger button for your modal box (ensure you have JS function like openCandidateModal() hooked up if needed) -->
                <button class="add-btn" onclick="openCandidateModal()">
                    + Add Candidate
                </button>
            </div>

            <!-- FILTER -->
            <div class="filter-box">
                <div class="search-box">
                    🔍
                    <input type="text" placeholder="Search candidate..." onkeyup="searchCandidates()" id="searchInput">
                </div>

                <select id="categoryFilter" onchange="filterCandidates()">
                    <option value="all">All Categories</option>
                    <option value="Boy">Boy</option>
                    <option value="Girl">Girl</option>
                </select>

                
            </div>

          <!-- CANDIDATE TABLE -->
           <div class="candidate-table">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Candidate</th>
                    <th>Candidate_no</th>
                    <th>Votes</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="candidateTable">
                <% if (typeof participants !== 'undefined' && participants.length > 0) { %>
                    <% participants.forEach((p, index) => { %>
                        <tr data-category="<%= p.gender.toLowerCase() %>">
                            <td><%= index + 1 %></td>
                            <td>
                                <div class="candidate-info">
                                    <% 
                                        let imagePath = p.photo;
                                        if (imagePath && !imagePath.startsWith('/') && !imagePath.startsWith('http')) {
                                            imagePath = '/uploads/' + imagePath;
                                        }
                                    %>
                                    <img src="<%= p.photo %>" alt="<%= p.name %>">
                                    <div>
                                        <strong><%= p.name %></strong>
                                        <small><%= p.major || p.description %></small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge">
                                    C-<%= String(index + 1).padStart(2, '0') %>
                                </span>
                            </td>
                            <td><strong><%= p.vote || 0 %></strong></td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <button type="button" class="edit-btn" onclick="toggleEditRow('<%= p.id %>')">Edit</button>
                                    <a href="/admin/delete/<%= p.id %>?section=candidates" class="delete-btn" onclick="return confirm('Are you sure you want to delete this candidate?');">Delete</a>
                                </div>
                            </td>
                        </tr>
                        <tr id="edit-row-<%= p.id %>" class="edit-panel-row">
                            <td colspan="5" style="padding: 0;">
                                <div class="edit-panel-content">
                                    <form action="/admin/update/<%= p.id %>?section=candidates" method="POST" enctype="multipart/form-data">
                                        <h4 style="margin-bottom: 12px; color: #4b2e83; font-size: 15px;">Edit Candidate: <%= p.name %></h4>
                                        <div class="edit-form-grid">
                                            <input type="text" name="name" value="<%= p.name %>" placeholder="Name" required />
                                            <input type="file" name="photo" />
                                            <input type="text" name="description" value="<%= p.major || p.description %>" placeholder="Major / Description" />
                                            <select name="gender" required>
                                                <option value="boy" <%= p.gender === 'boy' ? 'selected' : '' %>>Boy (King)</option>
                                                <option value="girl" <%= p.gender === 'girl' ? 'selected' : '' %>>Girl (Queen)</option>
                                            </select>
                                            <input type="text" name="hobby" value="<%= p.hobby || '' %>" placeholder="Hobby" />
                                            <input type="text" name="hometown" value="<%= p.hometown || '' %>" placeholder="Hometown" />
                                            
                                            <div class="edit-actions">
                                                <button type="button" class="btn-cancel" onclick="toggleEditRow('<%= p.id %>')">Cancel</button>
                                                <button type="submit" class="btn-save">Save Changes</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5">No candidates found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>


        <!-- Voter Page -->

        <section id="vote-page" class="page-section">

            <div class="page-header">
                <h1>Vote Records</h1>
                <p>View all voting records</p>
            </div>

            <div class="vote-table-container">
                <table class="vote-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Voter Name</th>
                            <th>Voter ID</th>
                            <th>Candidate</th>
                            <th>Vote Status</th>
                            <th>Date</th>
                            <th>Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Mg Mg</td>
                            <td>V001</td>
                            <td>Candidate A</td>
                            <td><span class="status voted">Voted</span></td>
                            <td>16 Aug 2026</td>
                            <td>10:30 AM</td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>Su Su</td>
                            <td>V002</td>
                            <td>Candidate B</td>
                            <td><span class="status voted">Voted</span></td>
                            <td>16 Aug 2026</td>
                            <td>10:45 AM</td>
                        </tr>

                        <tr>
                            <td>3</td>
                            <td>Aung Aung</td>
                            <td>V003</td>
                            <td>Candidate C</td>
                            <td><span class="status pending">Pending</span></td>
                            <td>-</td>
                            <td>-</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </section>

        <!-- Result Page -->

        <section id="result-page" class="page-section">

            <div class="page-header">
                <h1>Voting Results</h1>
                <p>View the current voting results</p>
            </div>

            <div class="result-container">

                <div class="result-card">
                    <h2>King</h2>

                    <table class="result-table">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Candidate Name</th>
                                <th>Total Votes</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>🥇 1</td>
                                <td>Mg Mg</td>
                                <td>450</td>
                                <td>45%</td>
                            </tr>

                            <tr>
                                <td>🥈 2</td>
                                <td>Aung Aung</td>
                                <td>320</td>
                                <td>32%</td>
                            </tr>

                            <tr>
                                <td>🥉 3</td>
                                <td>Kyaw Kyaw</td>
                                <td>230</td>
                                <td>23%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>


                <div class="result-card">
                    <h2>Queen</h2>

                    <table class="result-table">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Candidate Name</th>
                                <th>Total Votes</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>🥇 1</td>
                                <td>Su Su</td>
                                <td>520</td>
                                <td>52%</td>
                            </tr>

                            <tr>
                                <td>🥈 2</td>
                                <td>May May</td>
                                <td>300</td>
                                <td>30%</td>
                            </tr>

                            <tr>
                                <td>🥉 3</td>
                                <td>Ei Ei</td>
                                <td>180</td>
                                <td>18%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

        </section>

        <!-- Setting page -->

        <section id="setting-page" class="page-section">
            <form action="/admin/settings" method="POST">

                <div class="page-header">
                    <h1>Settings</h1>
                    <p>Manage your voting system settings</p>
                </div>

                <div class="settings-container">

                        <!-- Main Card Container -->
                        <!-- Countdown Control Card -->
                    <div class="settings-card w-full max-w-md bg-white/80 backdrop-blur-xl border border-white/80 rounded-2xl p-4 md:p-5 shadow-xl shadow-sky-900/5 relative flex flex-col justify-between">

                        <!-- Header Section -->
                        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200/80">
                            <div>
                                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-sky-700 bg-sky-100 px-2 py-0.5 rounded-full border border-sky-200 mb-1">
                                    MTU Fresher Welcome
                                </span>

                                <h1 class="text-lg font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
                                    Countdown Control
                                </h1>
                            </div>

                            <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center shadow-md shadow-sky-500/20 text-white text-base">
                                <i class="fa-solid fa-gauge-high"></i>
                            </div>
                        </div>


                        <div class="space-y-3">

                            <!-- Event Schedule Box -->
                            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-3 transition-all duration-300 hover:border-sky-300">

                                <div class="flex items-center gap-2 text-sky-700 text-[10px] font-bold tracking-wider uppercase mb-2">
                                    <i class="fa-regular fa-calendar-days text-xs"></i>
                                    <span>Event Schedule</span>
                                </div>

                                <div class="grid grid-cols-2 gap-2.5">

                                    <!-- Date -->
                                    <div class="space-y-1">
                                        <label for="eventDate"
                                            class="block text-[10px] font-semibold text-slate-600">
                                            Event Date
                                        </label>

                                        <input type="date"
                                            id="eventDate"
                                            name= "event_date"
                                            class="w-full bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500/20 transition-all">
                                    </div>


                                    <!-- Start Time -->
                                    <div class="space-y-1">
                                        <label for="startTime"
                                            class="block text-[10px] font-semibold text-slate-600">
                                            Start Time
                                        </label>

                                        <input type="time"
                                            id="startTime"
                                            name="start_time"
                                            class="w-full bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500/20 transition-all">
                                    </div>

                                </div>
                            </div>


                            <!-- Countdown Duration Box -->
                            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-3 transition-all duration-300 hover:border-sky-300">

                                <div class="flex items-center gap-2 text-sky-700 text-[10px] font-bold tracking-wider uppercase mb-2">
                                    <i class="fa-solid fa-stopwatch text-xs"></i>
                                    <span>Countdown Duration</span>
                                </div>

                                <div class="space-y-1">

                                    <input type="text"
                                        id="countdownTime"
                                        name="duration"
                                        value="00:05:00"
                                        maxlength="8"
                                        placeholder="HH:MM:SS"
                                        class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center text-sm font-bold tracking-widest text-sky-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500/20 transition-all">

                                    <p class="text-[9px] text-slate-400 text-center font-medium">
                                        Format: HH:MM:SS
                                    </p>

                                </div>
                            </div>


                            <!-- Action Controls -->
                            <div class="grid grid-cols-2 gap-2">

                                <!-- Start -->
                                <button type="button" onclick="startCountdown()"
                                    class="col-span-2 group relative inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white text-xs font-bold rounded-lg shadow-md shadow-sky-600/20 active:scale-[0.98] transition-all overflow-hidden">

                                    <span class="absolute inset-0 w-full h-full bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></span>

                                    <i class="fa-solid fa-play text-[10px] transition-transform group-hover:scale-110"></i>

                                    <span>Start Countdown</span>
                                </button>


                                <!-- Pause -->
                                <button type="button" onclick="pauseCountdown()"
                                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 text-[11px] font-bold rounded-lg active:scale-[0.98] transition-all">

                                    <i class="fa-solid fa-pause"></i>
                                    <span>Pause</span>

                                </button>


                                <!-- Resume -->
                                <button type="button" onclick="resumeCountdown()"
                                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-[11px] font-bold rounded-lg active:scale-[0.98] transition-all">

                                    <i class="fa-solid fa-play"></i>
                                    <span>Resume</span>

                                </button>


                                <!-- Reset -->
                                <button type="button" onclick="resetCountdown()"
                                    class="col-span-2 inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-[11px] font-bold rounded-lg active:scale-[0.98] transition-all">

                                    <i class="fa-solid fa-rotate-left"></i>
                                    <span>Reset Control State</span>

                                </button>

                            </div>


                            <!-- Status -->
                            <div id="status"
                                class="flex items-center justify-center gap-2 py-2 px-3 bg-sky-50/80 border border-sky-100 rounded-lg text-sky-900 text-[11px] font-semibold tracking-wide transition-all">

                                <i class="fa-solid fa-circle-info text-sky-600"></i>

                                <span>Status: Ready</span>

                            </div>

                        </div>
                    </div>

                    


                    <!-- Voting Settings -->
                    <div class="settings-card">
                        <h2>Voting Settings</h2>

                        <div class="setting-item">
                            <div>
                                <h3>One Vote Per Student</h3>
                                <p>Allow each student to vote only once.</p>
                            </div>

                            <label class="switch">
                                <input type="checkbox" id="oneVote" name="one_vote_per_student" <%= settings && settings.one_vote_per_student ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-item">
                            <div>
                                <h3>Show Results</h3>
                                <p>Allow students to see voting results.</p>
                            </div>

                            <label class="switch">
                                <input type="checkbox" id="showResults" name="show_results" <%= settings && settings.show_results ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-item">
                            <div>
                                <h3>Candidate Registration</h3>
                                <p>Allow candidates to register for the election.</p>
                            </div>

                            <label class="switch">
                                <input type="checkbox" id="candidateRegistration" name="candidate_registration" <%= settings && settings.candidate_registration ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>


                    <!-- Security Settings -->
                    <div class="settings-card">
                        <h2>Security</h2>

                        <div class="form-group">
                            <label for="adminPassword">Admin Password</label>
                            <input type="password"
                                id="adminPassword"
                                name="admin_password"
                                placeholder="Enter new password">
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <input type="password"
