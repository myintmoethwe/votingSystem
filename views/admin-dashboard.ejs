</script>
 <script src="/socket.io/socket.io.js"></script>
<script>
// PAGE NAVIGATION & INITIALIZATION
function showPage(page, clickedLink) {
    document.querySelectorAll(".page-section").forEach(section => {
        section.style.display = "none";
    });

    const targetPage = document.getElementById(page + "-page");
    if (targetPage) {
        targetPage.style.display = "block";
    }

    document.querySelectorAll(".sidebar a").forEach(link => {
        link.classList.remove("active");
    });

    const matchingSidebarLink = document.querySelector(`.sidebar a[href="#${page}-page"]`);
    if (matchingSidebarLink) {
        matchingSidebarLink.classList.add("active");
    } else if (clickedLink) {
        clickedLink.classList.add("active");
    }
}

window.onload = function() {
    const urlParams = new URLSearchParams(window.location.search);
    const activeSection = urlParams.get("section");

    if (activeSection) {
        const matchingLink = document.querySelector(`.sidebar a[href="#${activeSection}-page"]`);
        showPage(activeSection, matchingLink);
    } else {
        showPage("dashboard");
    }
};

// SETTINGS MANAGEMENT
function saveSettings() {
    const electionName = document.getElementById("electionName").value;
    const status = document.getElementById("electionStatus").value;
    const oneVote = document.getElementById("oneVote").checked;
    const showResults = document.getElementById("showResults").checked;

    console.log("Election:", electionName);
    console.log("Status:", status);
    console.log("One Vote:", oneVote);
    console.log("Show Results:", showResults);

    alert("Settings saved successfully!");
}

function resetSettings() {
    document.getElementById("electionName").value = "King & Queen Voting 2026";
    document.getElementById("electionStatus").value = "open";
    document.getElementById("oneVote").checked = true;
    document.getElementById("showResults").checked = false;
    document.getElementById("candidateRegistration").checked = false;
}

// CANDIDATE FILTERING & SEARCH
function filterCandidates() {
    applyFilters();
}

function searchCandidates() {
    applyFilters();
}

function applyFilters() {
    const searchInput = document.getElementById("searchInput");
    const categoryFilter = document.getElementById("categoryFilter");
    
    if (!searchInput || !categoryFilter) return;

    const query = searchInput.value.toLowerCase().trim();
    const filter = categoryFilter.value.toLowerCase().trim();
    
    document.querySelectorAll("#candidateTable tr[data-category]").forEach(row => {
        const cat = row.getAttribute("data-category").toLowerCase().trim();
        const nameElement = row.querySelector(".candidate-info strong");
        const candidateName = nameElement ? nameElement.textContent.toLowerCase() : "";
        
        const matchesCategory = filter === "all" || cat === filter;
        const matchesSearch = query === "" || candidateName.includes(query);
        
        const shouldShow = matchesCategory && matchesSearch;
        row.style.display = shouldShow ? "" : "none";

        const candidateId = row.querySelector('.edit-btn')?.getAttribute('onclick')?.match(/'([^']+)'/)?.[1];
        const editRow = candidateId ? document.getElementById(`edit-row-${candidateId}`) : null;
        if (!shouldShow && editRow) editRow.style.display = "none";
    });
}

// EDIT ROW TOGGLE
function toggleEditRow(id) {
    const row = document.getElementById(`edit-row-${id}`);
    if (row.classList.contains('active')) {
        row.classList.remove('active');
    } else {
        document.querySelectorAll('.edit-panel-row').forEach(r => r.classList.remove('active'));
        row.classList.add('active');
    }
}

// COUNTDOWN CONTROLS
function setStatus(text) {
    const statusEl = document.getElementById("status");
    if (statusEl) {
        statusEl.innerHTML = `
            <i class="fa-solid fa-circle-info text-sky-600"></i>
            <span>${text}</span>
        `;
    }
}

async function startCountdown(event) {
    const submitButton = event ? event.target : null;

    const eventDateEl = document.getElementById('eventDate');
    const startTimeEl = document.getElementById('startTime');
    const countdownTimeEl = document.getElementById('countdownTime');

    if (!eventDateEl || !startTimeEl || !countdownTimeEl) {
        alert("Required form elements are missing from the page.");
        return;
    }

    const eventDate = eventDateEl.value;
    const startTime = startTimeEl.value;
    const countdownTime = countdownTimeEl.value;

    if (!eventDate || !startTime) {
        alert("Please select both the Event Date and Start Time.");
        return;
    }

    if (!countdownTime || countdownTime.split(':').length !== 3) {
        alert("Please provide a valid countdown time in HH:MM:SS format.");
        return;
    }

    const targetDateTime = new Date(`${eventDate}T${startTime}`).getTime();
    if (isNaN(targetDateTime)) {
        alert("Invalid date or time format.");
        return;
    }
    
    const parts = countdownTime.split(':');
    const hours = parseInt(parts[0], 10) || 0;
    const minutes = parseInt(parts[1], 10) || 0;
    const seconds = parseInt(parts[2], 10) || 0;
    const durationMs = (hours * 3600 + minutes * 60 + seconds) * 1000;

    const payload = {
        target_time: targetDateTime,
        remaining: durationMs,
        duration: durationMs,
        countdown_status: "running"
    };

    if (submitButton) submitButton.disabled = true;

    try {
        const response = await fetch('/admin/update-countdown', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            throw new Error(`Server returned status ${response.status}`);
        }

        const result = await response.json();
        if (result.success) {
            if (typeof setStatus === 'function') {
                setStatus("Status: Running");
            }
            alert("Countdown started successfully and saved to database!");
        } else {
            alert(result.error || "Failed to save countdown.");
        }
    } catch (err) {
        console.error("Error:", err);
        alert("Failed to connect to server or process response.");
    } finally {
        if (submitButton) submitButton.disabled = false;
    }
}

async function pauseCountdown() {
    try {
        const response = await fetch("/admin/pause", { method: "POST" });
        const data = await response.json();

        if (data.success) {
            setStatus("Status: Paused");
        } else {
            alert(data.message || "Cannot pause countdown.");
        }
    } catch (error) {
        alert("Failed to connect to server.");
    }
}

async function resumeCountdown() {
    try {
        const response = await fetch("/admin/resume", { method: "POST" });
        const data = await response.json();

        if (data.success) {
            setStatus("Status: Running");
        } else {
            alert(data.message || "Cannot resume countdown.");
        }
    } catch (error) {
        alert("Failed to connect to server.");
    }
}

async function resetCountdown() {
    if (!confirm("Are you sure you want to reset the countdown?")) {
        return;
    }

    try {
        const response = await fetch("/admin/reset", { method: "POST" });
        const data = await response.json();

        if (data.success) {
            setStatus("Status: Reset");
            if (document.getElementById("eventDate")) document.getElementById("eventDate").value = "";
            if (document.getElementById("startTime")) document.getElementById("startTime").value = "";
            if (document.getElementById("countdownTime")) document.getElementById("countdownTime").value = "00:05:00";
        } else {
            alert("Failed to reset countdown.");
        }
    } catch (error) {
        alert("Failed to connect to server.");
    }
}

// LIVE SYNC VIA SOCKET.IO (Replaces polling interval)
document.addEventListener("DOMContentLoaded", () => {
    const socket = io();

    socket.on("countdownUpdated", (data) => {
        console.log("Admin real-time countdown update received:", data);

        if (!data || !data.target_time) return;

        const now = new Date().getTime();
        const targetTime = new Date(data.target_time).getTime();
        const timeLeft = targetTime - now;

        const statusLower = (data.countdown_status || "").toLowerCase();

        if (statusLower === 'running') {
            if (timeLeft > 0) {
                const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                const countdownElement = document.getElementById('countdown-display');
                if (countdownElement) {
                    countdownElement.innerText = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                }
                
                const statusEl = document.getElementById("status");
                if (statusEl) statusEl.innerHTML = '<i class="fa-solid fa-circle-info text-sky-600"></i><span>Status: Running</span>';
            } else {
                updateUIToRunningState(data.duration);
            }
        } else if (statusLower === 'paused') {
            displayPausedState();
        } else if (statusLower === 'reset') {
            displayResetState();
        }
    });
});

function updateUIToRunningState(duration) {
    const countdownElement = document.getElementById('countdown-display');
    if (countdownElement) {
        countdownElement.innerText = "Voting Active!";
    }
}

function displayPausedState() {
    const statusEl = document.getElementById('status');
    if (statusEl) statusEl.innerHTML = '<i class="fa-solid fa-circle-info text-amber-600"></i><span>Status: Paused</span>';
}

function displayResetState() {
    const statusEl = document.getElementById('status');
    if (statusEl) statusEl.innerHTML = '<i class="fa-solid fa-circle-info text-rose-600"></i><span>Status: Reset</span>';
}
</script>
