<!DOCTYPE html>
<html>
<head>
  <title>Voting System - Home</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    .header { display: flex; justify-content: space-between; align-items: center; }
    .grid { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px; }
    .card { border: 1px solid #ccc; border-radius: 8px; padding: 15px; width: 220px; text-align: center; }
    .card img { width: 100%; height: 180px; object-fit: cover; border-radius: 6px; }
    .btn { padding: 8px 16px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; }
    .vote-option { margin-top: 10px; display: block; font-weight: bold; cursor: pointer; }
    .error { color: red; font-weight: bold; margin-top: 10px; }
    .success { color: green; font-weight: bold; margin-top: 10px; }
  </style>
</head>
<body>

  <div class="header">
    <h1>Public Voting Poll</h1>
    <div>
      <% if (user && user.isAdmin) { %>
        <span>Logged in as <strong>Admin</strong></span> | 
        <a href="/admin/dashboard" class="btn" style="background: #28a745;">Admin Dashboard</a> | 
        <a href="/logout">Logout</a>
      <% } %>
    </div>
  </div>
  <hr>

  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form action="/vote" method="POST">
    <div class="grid">
      <% participants.forEach(p => { %>
        <div class="card">
          <img src="<%= p.photo %>" alt="<%= p.name %>">
          <h3><%= p.name %></h3>
          <p><%= p.description %></p>

<% if (!locals.hasVoted && (!locals.user || !locals.user.isAdmin)) { %>
              <label class="vote-option">
              <input type="radio" name="participantId" value="<%= p.id %>" required> Vote
            </label>
          <% } %>
        </div>
      <% }) %>
    </div>

    <% if (locals.hasVoted) { %>
  <br>
  <p class="success">Thank you! Your vote has been recorded.</p>
<% } else if (!locals.user || !locals.user.isAdmin) { %>
  <br>
  <button type="submit" class="btn">Submit Vote</button>
<% } %>
  </form>

</body>
</html>